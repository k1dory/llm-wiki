# Скопируй в .env

# Основной токен (rw): и чтение, и запись. Им подписывает запросы UI и ходит
# MCP-клиент (Claude Code). Пока пусто — вики полностью открыта (только для локалки).
# Задан — закрывается и запись, и чтение: аноним без токена не получит ни страницы.
TOKEN=

# Токен только на чтение (ro). Нужен клиентам и людям, которым дать «только смотреть».
# Основной TOKEN (rw) чтение наследует — этот нужен, лишь чтобы выдать чтение без записи.
READ_TOKEN=

# Адрес, на котором публикуются порты на хосте. По умолчанию 127.0.0.1 — наружу
# контейнеры отдаёт edge-Caddy через docker-сеть. Ставь 0.0.0.0 только осознанно
# и только там, где перед портами нет прокси: иначе API открыт в обход Caddy.
BIND_ADDR=127.0.0.1

# Порты на хосте (в паре с BIND_ADDR)
WEB_PORT=8080
API_PORT=8081
MCP_PORT=8082
