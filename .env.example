# Скопируй в .env

# Полный доступ: чтение и запись. Им же подписывает запросы UI,
# с ним же ходит MCP-клиент (Claude Code).
WRITE_TOKEN=

# Доступ на чтение. Пока пусто — вики читает кто угодно, кто дотянулся до порта.
# Задан — закрыта целиком: без токена не отдаётся ни одна страница.
# Для закрытого контура задавать обязательно.
READ_TOKEN=

# Порты на хосте
WEB_PORT=8080
API_PORT=8081
MCP_PORT=8082
