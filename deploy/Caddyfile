{
	# Вложенные подстановки Caddy не понимает, поэтому почта задаётся целиком.
	email admin@infrashark.tech
	# Для отладки конфига без обращения к Let's Encrypt раскомментируй:
	 acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format console
	}
}

# --- UI. Стоит обособленно: свой контейнер, свой апстрим, ничего больше не проксирует.
wiki.{$WIKI_DOMAIN} {
	import common
	reverse_proxy {$WIKI_UPSTREAM:wiki:80}
}

# --- REST API. Нужен только внешним клиентам: UI ходит в API через свой origin.
api.wiki.{$WIKI_DOMAIN} {
	import common
	reverse_proxy {$API_UPSTREAM:api:8080}
}

# --- MCP. Streamable HTTP: ответы приходят как SSE, буферизацию отключаем.
mcp.wiki.{$WIKI_DOMAIN} {
	import common
	reverse_proxy {$MCP_UPSTREAM:mcp:8090} {
		flush_interval -1
		transport http {
			response_header_timeout 5m
		}
	}
}
