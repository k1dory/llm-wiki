# Скопируй в deploy/.env

# Домен: даст wiki.<домен>, api.wiki.<домен>, mcp.wiki.<домен>
WIKI_DOMAIN=genomed-security.ru

# Почта для Let's Encrypt (уведомления об истечении сертификатов)
ACME_EMAIL=

# Апстримы. Меняй, только если контейнер живёт вне сети llm-wiki_default.
WIKI_UPSTREAM=wiki:80
API_UPSTREAM=api:8080
MCP_UPSTREAM=mcp:8090
